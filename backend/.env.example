# --- Database Configuration ---
# 格式: postgresql+asyncpg://user:password@host:port/dbname
# 开发环境通常填 localhost，生产环境填服务器IP
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/factory_db

# --- Security ---
# 生产环境务必修改此 Key！可以使用 `openssl rand -hex 32` 生成
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_PLEASE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Admin Initial Setup (Optional) ---
# 如果有自动创建超级管理员的脚本，这里可以预留配置
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=changethis

# --- Deployment ---
#以此来区分是开发环境(dev)还是生产环境(prod)
ENVIRONMENT=dev